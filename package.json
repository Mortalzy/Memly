{
  "name": "memly",
  "version": "0.0.0",
  "private": true,
  "description": "Flashcards, study modes, tests and learning games",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "npm run dev --workspace=@memly/web",
    "build": "npm run build --workspace=@memly/web",
    "preview": "npm run preview --workspace=@memly/web",
    "typecheck": "npm run typecheck --workspace=@memly/web",
    "test": "npm run test --workspace=@memly/web",
    "format": "prettier --write apps/web package.json docs/prototype.md .openai/hosting.json",
    "format:check": "prettier --check apps/web package.json docs/prototype.md .openai/hosting.json"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
