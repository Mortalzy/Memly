{
  "name": "@memly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@memly/contracts": "*",
    "@memly/database": "*",
    "better-auth": "1.7.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "nodemailer": "10.0.16",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.1",
    "smtp-server": "3.19.18",
    "supertest": "7.3.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
